<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    
    <!-- MSBuild configuration for .NET 8.0 -->
    <MSBuildEnableWorkloadResolver>true</MSBuildEnableWorkloadResolver>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn for C# code analysis - Updated for .NET 8.0 compatibility -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
    
    <!-- MEF Composition required by Roslyn workspaces for .NET 8.0 -->
    <!-- Explicitly set CopyLocal to ensure assemblies are available at runtime -->
    <PackageReference Include="System.Composition.AttributedModel" Version="8.0.0" PrivateAssets="none" />
    <PackageReference Include="System.Composition.Convention" Version="8.0.0" PrivateAssets="none" />
    <PackageReference Include="System.Composition.Hosting" Version="8.0.0" PrivateAssets="none" />
    <PackageReference Include="System.Composition.Runtime" Version="8.0.0" PrivateAssets="none" />
    <PackageReference Include="System.Composition.TypedParts" Version="8.0.0" PrivateAssets="none" />
    
    <!-- MSBuild integration - Updated for better .NET 8.0 and VS 2022 support -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    
    <!-- Project analysis - Updated for .NET 8.0 SDK compatibility -->
    <PackageReference Include="Buildalyzer" Version="8.0.0" />
    <PackageReference Include="Buildalyzer.Workspaces" Version="8.0.0" />
    
    <!-- Fuzzy string matching -->
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
  </ItemGroup>

</Project>
